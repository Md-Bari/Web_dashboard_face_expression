# Environment configuration for EMP-EDU. Copy to .env and fill in SECRET_KEY
# (generate: python -c "import secrets; print(secrets.token_urlsafe(50))") and the LiveKit keys.

# ---------------------------------------------------------------- Core (required)
DEBUG=False
SECRET_KEY=
# Hostnames Django answers to (comma separated); add your own domain if you use one
ALLOWED_HOSTS=localhost,127.0.0.1,backend,.trycloudflare.com
# Extra HTTPS origins allowed to POST (admin login), comma separated, e.g. https://emp-edu.example.com
CSRF_TRUSTED_ORIGINS=
# True only when the site is served over HTTPS (tunnel / domain); False for http://localhost
AUTH_COOKIE_SECURE=False

# ---------------------------------------------------------------- Ports
# Public entry point (nginx); open http://localhost:8080
PUBLIC_PORT=8080
# Local-only direct Django API/admin access
BACKEND_PORT=8000
# Host ports for the database and Redis (localhost only)
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# ---------------------------------------------------------------- Database / Redis
# Used by local (non-Docker) runs; docker-compose.yml sets these for the containers itself
POSTGRES_DB=emp_edu_db
POSTGRES_USER=emp_edu_user
POSTGRES_PASSWORD=emp_edu_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------- Admin portal
# Created by the first `migrate` (signs in on the normal login page, lands on /admin).
# Defaults: shitol@admin / 123456 - change the password after the first sign-in.
# ADMIN_USERNAME=shitol@admin
# ADMIN_PASSWORD=123456

# ---------------------------------------------------------------- Class features
# Open no-login student roster (development only)
ALLOW_GUEST_STUDENTS=False
# A live session is ended automatically after this many hours
SESSION_MAX_HOURS=4
# Save one face photo per student per expression (needs student consent)
EXPRESSION_SNAPSHOTS_ENABLED=True
EXPRESSION_SNAPSHOT_MIN_CONFIDENCE=0.5
# Name faces in the shared screen automatically (needs face_recognition_sface_2021dec.onnx in models/)
FACE_RECOGNITION_ENABLED=True

# ---------------------------------------------------------------- Video meetings (LiveKit)
# https://cloud.livekit.io -> your project -> Settings -> Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------- Frontend
# Leave empty for same-origin (nginx / tunnel). For local dev without Docker:
# http://localhost:8000 and ws://localhost:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
