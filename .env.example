# Environment Configuration for EMP-EDU

# Backend
DEBUG=True
SECRET_KEY=emp-edu-secure-production-key-change-me
POSTGRES_DB=emp_edu_db
POSTGRES_USER=emp_edu_user
POSTGRES_PASSWORD=emp_edu_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

# Public entry point (nginx). This is also the origin the Cloudflare tunnel proxies.
PUBLIC_PORT=8080
# Local-only port for direct Django API/admin access (not used publicly).
BACKEND_PORT=8000

# Extra HTTPS origins allowed to POST (admin login CSRF), comma separated.
# Quick tunnels (*.trycloudflare.com) are trusted by default; for a named tunnel
# on your own domain add e.g. https://emp-edu.example.com
CSRF_TRUSTED_ORIGINS=

# Frontend: leave empty for same-origin (single tunnel hostname / nginx).
# Set these only when the backend runs on a separate origin, e.g. for plain
# local development without Docker: http://localhost:8000 and ws://localhost:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
